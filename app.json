{
  "expo": {
    "name": "EffnerApp",
    "slug": "EffnerApp",
    "version": "3.4.1",
    "orientation": "default",
    "icon": "./@resources/default_icon.png",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "73",
      "userInterfaceStyle": "automatic",
      "bundleIdentifier": "de.effnerapp.effner",
      "supportsTablet": true
    },
    "android": {
      "package": "de.effnerapp.effner",
      "versionCode": 130,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./@resources/android_icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./@resources/default_icon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./@resources/push_icon.png",
          "color": "#ffffff"
        }
      ],
      "expo-build-properties",
      "expo-asset",
      "expo-font",
      "@react-native-vector-icons/material-icons",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons"
    ],
    "extra": {
      "eas": {
        "projectId": "906a3c44-1378-4fe9-8633-34076d1f1fe1"
      }
    }
  }
}
